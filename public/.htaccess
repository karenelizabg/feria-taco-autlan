# Feria del Taco Autlán · Hostinger (Apache / LiteSpeed)
# Este archivo se copia a la raíz de public_html junto con el contenido de dist/.

Options -Indexes

# 1) HTTPS obligatorio y dominio sin www (301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://feriadeltacoautlan.com%{REQUEST_URI} [L,R=301]
</IfModule>

# 2) Página 404 propia (public/404.html)
ErrorDocument 404 /404.html

# 3) Encabezados de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # El script inline de <head> está permitido por hash (sha256 de: document.documentElement.classList.add('js'))
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'"
  # HSTS: activar solo cuando el SSL esté verificado (ver checklist)
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# 4) Caché: HTML siempre validado; JS/CSS con nombre hasheado, caché larga; imágenes, un mes
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# 5) Compresión (si el servidor la ofrece)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
